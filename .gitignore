# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ─── Código-fonte (protegido / não distribuído publicamente) ──────────────────
*.py
!examples/**/*.py

# ─── Ambiente virtual ─────────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── Build / PyInstaller ──────────────────────────────────────────────────────
build/
*.spec

# ─── Banco SQLite interno (contém senhas de usuários) ────────────────────────
instance/
*.db
*.sqlite
*.sqlite3

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── Configurações com credenciais ───────────────────────────────────────────
web.config
.env
.env.*
config_local.py

# ─── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── dist: manter apenas o executável compilado ──────────────────────────────
# (o .exe e os arquivos de suporte do PyInstaller são incluídos)
# Exclui apenas arquivos desnecessários dentro do dist
dist/**/__pycache__/
dist/**/*.pyc
